# Dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build and generated output
dist/
dist-ssr/
build/
dist-installer/
graphify-out/
installer-ui/build/

# Electron generated output
release/
out/
dist-electron/
dist-installer/
installer-ui/*.exe
*.exe

# FFmpeg runtime DLLs.
#
# The engine links the FFmpeg *shared* libraries, so avcodec/avformat/... DLLs must
# sit next to panamedia-core.exe at run time. They are third-party binaries
# fetched per machine, not source, and they are large -- so they are copied in
# after the build and never committed. Only the .exe is tracked.
src-cpp/build/
ffmpeg-dev/

# CMake scratch trees other than the default `build` one.
src-cpp/build-*/

# Local environment and machine-specific files
*.local
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

extension/key.pem
