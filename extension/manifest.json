{
  "manifest_version": 3,
  "name": "net-downloader Integration",
  "version": "1.0",
  "description": "Integrates net-downloader with Chrome/Edge. Hijacks default downloads and handles high-speed multi-threaded downloading.",
  "key": "",
  "permissions": [
    "downloads",
    "downloads.shelf",
    "cookies",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/watch*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}