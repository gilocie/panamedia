{
  "appId": "com.panamedia.installer",
  "productName": "PanamediaSetup",
  "copyright": "Copyright © 2026 Panamedia",
  "icon": "panamedia.ico",
  "directories": {
    "output": "../dist-installer",
    "buildResources": "build"
  },
  "electronVersion": "42.4.1",
  "files": [
    "main.cjs",
    "index.html",
    "panamedia.ico",
    "icons.svg"
  ],
  "extraResources": [
    {
      "from": "nsis-installer.exe",
      "to": "nsis-installer.exe"
    },
    {
      "from": "../src/assets/playerbg.jpg",
      "to": "playerbg.jpg"
    },
    {
      "from": "panamedia.ico",
      "to": "panamedia.ico"
    },
    {
      "from": "../public/player.ico",
      "to": "player.ico"
    },
    {
      "from": "icons.svg",
      "to": "icons.svg"
    }
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "panamedia.ico",
    "requestedExecutionLevel": "requireAdministrator",
    "artifactName": "PanamediaSetup.exe"
  },
  "portable": {
    "artifactName": "PanamediaSetup.exe",
    "requestExecutionLevel": "admin"
  },
  "compression": "maximum"
}
